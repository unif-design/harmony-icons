export function getUnifIconDefinition(iconName: UnifIconName): UnifIconDefinition {
  const definition = definitions.find((item: UnifIconDefinition): boolean => item.iconName === iconName);
  if (definition === undefined) {
    throw new Error('Unknown icon: ' + iconName);
  }
  return definition;
}
